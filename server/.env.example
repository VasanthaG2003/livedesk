# Copy to server/.env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/livedesk?retryWrites=true&w=majority
# In development only, the value "memory" starts a throwaway in-memory MongoDB
# (data is lost on restart).
MONGODB_URI=memory

# Comma-separated list of browser origins allowed to call the API and open sockets.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Number of reverse proxies in front of the app (Render = 1). Used for client IPs
# in rate limiting and for Secure cookies. Use 0 when running locally.
TRUST_PROXY=0

# Random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-0000000000
JWT_SOCKET_SECRET=replace-me-with-a-different-long-random-string-00

LOG_LEVEL=info

# Optional: enables AI assist (category/priority suggestions, reply drafts).
# Leave unset to switch AI features off. AI_MODEL defaults to claude-opus-5-5.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
