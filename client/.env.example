# Production only (set in Vercel → Settings → Environment Variables).
# Vercel can't proxy WebSockets, so subscriptions connect to the API host directly.
# In development leave it unset: the Vite dev server proxies /graphql (HTTP + WS).
# VITE_GRAPHQL_WS_URL=wss://livedesk-api-bi6i.onrender.com/graphql
